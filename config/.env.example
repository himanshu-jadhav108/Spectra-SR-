APP_NAME=Spectra SR
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./storage/db/spectra_sr.sqlite3
ARTIFACT_ROOT=./storage/jobs
SCENE_CACHE_ROOT=./storage/cache/scenes
MODEL_ROOT=./storage/models

# Copernicus Data Space / Sentinel Hub credentials
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Default data source for local development
DATA_SOURCE=local

# Processing defaults
DEVICE=cuda
SR_MODEL=sen2sr_lite
TARGET_GSD_M=2.5
WINDOW_SIZE=128
WINDOW_OVERLAP=16
MAX_CONCURRENT_JOBS=1

# Prototype trust thresholds; configurable only
LOW_RISK_THRESHOLD=0.25
MEDIUM_RISK_THRESHOLD=0.50
